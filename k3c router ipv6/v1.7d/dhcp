
config dnsmasq
	option user 'admin'
	option domainneeded '1'
	option boguspriv '1'
	option expandhosts '1'
	option leasefile '/tmp/leasefile'
	option resolvfile '/tmp/resolv.conf.auto'
	option nonwildcard '1'
	option authoritative '1'
	list interface 'br-lan'
	option rebind_protection '0'
	list listenaddress '127.0.0.1'
	list listenaddress '192.168.3.1'

config dhcp 'lan'
	option interface 'lan'
	option dhcpv4_dnsmasq 'server'
	option start '100'
	option limit '100'
	option leasetime '86400'
	list dhcp_option '3,192.168.3.1'
	list dhcp_option '6,192.168.3.1'
	option ra 'server'
	option dhcpv6 'server'
	option ra_management '1'
	list dns '2408:8000:1010:1::8'
	list dns '2408:8000:1010:2::8'

config host
	option ip '192.168.3.22'
	option mac '98:5f:d3:3b:a1:b2'

config host
	option ip '192.168.3.200'
	option mac 'b4:2e:99:63:a9:a8'

config odhcpd 'odhcpd'
	option maindhcp '0'
	option leasefile '/tmp/odhcpd'
	option leasetrigger '/usr/sbin/odhcpd-update'

